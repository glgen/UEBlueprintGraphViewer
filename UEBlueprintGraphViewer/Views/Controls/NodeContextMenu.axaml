<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:UEBlueprintGraphViewer"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="local:GameSettings"
             x:Class="UEBlueprintGraphViewer.NodeContextMenu">
	<UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="5"/>
		</Style>
	</UserControl.Styles>
	<Grid MaxHeight="300">
		<StackPanel>
			<Button Content="Follow pin" Click="FollowPin_OnClick" x:Name="FollowPin"/>
			<Button Content="Copy pin value" Click="CopyPinValue_OnClick" x:Name="CopyPinValue"/>
			<Button Content="Open in json" Click="OpenInJson_OnClick"/>
			<Button Content="Toggle breakpoint" Click="ToggleBreakpoint_OnClick" IsVisible="{x:Static local:Settings.DebuggerMode}"/>
			<Button Content="Collapse to macro" Click="CollapseToMacroButton_OnClick"/>
			<Button Content="Delete" Click="DeleteButton_OnClick"/>
		</StackPanel>
	</Grid>
</UserControl>
