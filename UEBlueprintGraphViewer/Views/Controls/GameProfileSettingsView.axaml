<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:UEBlueprintGraphViewer"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="local:GameSettings"
             x:Class="UEBlueprintGraphViewer.GameProfileSettingsView">
	<UserControl.Styles>
		<Style Selector="Button">
			<Setter Property="Margin" Value="3"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="Padding" Value="5,3"/>
		</Style>
	</UserControl.Styles>
	<Grid ColumnDefinitions="150,*,28,85" RowDefinitions="32,32,32,32">
		<TextBlock Grid.Row="0" Text="Paks folder" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="1" Text="Engine version" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="2" Text="Game dump" VerticalAlignment="Center"/>
		<TextBlock Grid.Row="3" Text="Mappings file" VerticalAlignment="Center"/>

		<TextBlock Grid.Row="2" ToolTip.Tip="Object dump .txt file obtained from UE4SS" Classes="Hint"/>
		<TextBlock Grid.Row="3" ToolTip.Tip=".usmap or .jmap file for UE5 games" Classes="Hint"/>


		<TextBox Text="{Binding PaksFolder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"/>
		<Button x:Name="LoadFolderButton" Grid.Column="3" Grid.Row="0" Content="Select folder" Click="LoadFolderButton_Click"/>

		<ComboBox Grid.Column="1" Grid.Row="1" Margin="3" Width="120" HorizontalAlignment="Left"
				  ItemsSource="{x:Static local:GameProfileSettingsView.VersionOptions}" SelectedItem="{Binding UEVersion}"/>

		<TextBox Text="{Binding ObjectDump}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"/>
		<Button x:Name="LoadDumpButton" Grid.Column="3" Grid.Row="2" Content="Select file" Click="LoadDumpButton_Click"/>

		<TextBox Text="{Binding Mappings}" Grid.Column="1" Grid.Row="3"/>
		<Button x:Name="EraseUsmapButton" Grid.Column="2" Grid.Row="3" Content="X" Click="EraseUsmapButton_Click"/>
		<Button x:Name="LoadUsmapButton" Grid.Column="3" Grid.Row="3" Content="Select file" Click="LoadUsmapButton_Click"/>
	</Grid>
</UserControl>
