<UserControl x:Class="UEBlueprintGraphViewer.Views.AssetInfoPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:UEBlueprintGraphViewer"
             xmlns:vm="clr-namespace:UEBlueprintGraphViewer.ViewModels"
             x:DataType="vm:AssetViewModel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Styles>
		<Style Selector="ListBox.Func">
			<Setter Property="ItemTemplate">
				<Setter.Value>
					<DataTemplate x:DataType="vm:AssetFunctionViewModel">
						<TextBlock Text="{Binding Name}"
						           Padding="5,3"
						           Background="Transparent"
						           DoubleTapped="FunctionList_DoubleTapped"
						           Classes.Comparable="True"
						           Classes.IsAdded="{Binding ChangeStatus, ConverterParameter=Added, Converter={StaticResource ObjStrToBoolConverter}}"
						           Classes.IsRemoved="{Binding ChangeStatus, ConverterParameter=Removed, Converter={StaticResource ObjStrToBoolConverter}}"
						           Classes.IsChanged="{Binding ChangeStatus, ConverterParameter=Changed, Converter={StaticResource ObjStrToBoolConverter}}">
						</TextBlock>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="ListBox.Prop">
			<Setter Property="ItemTemplate">
				<Setter.Value>
					<DataTemplate x:DataType="vm:AssetPropertyViewModel">
						<StackPanel Orientation="Horizontal">
							<local:PinConnector PinType="{Binding Type}" Width="19" Height="19"/>
							<TextBlock Text="{Binding Name}"
							           Padding="5,3"
							           Background="Transparent"
							           DoubleTapped="PropertyList_DoubleTapped"
							           Classes.Comparable="True"
							           Classes.IsAdded="{Binding ChangeStatus, ConverterParameter=Added, Converter={StaticResource ObjStrToBoolConverter}}"
							           Classes.IsRemoved="{Binding ChangeStatus, ConverterParameter=Removed, Converter={StaticResource ObjStrToBoolConverter}}"
							           Classes.IsChanged="{Binding ChangeStatus, ConverterParameter=Changed, Converter={StaticResource ObjStrToBoolConverter}}">
							</TextBlock>
						</StackPanel>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Styles>
    <Grid Background="{StaticResource Background3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition MinHeight="50"/>
            <RowDefinition Height="5"/>
            <RowDefinition MinHeight="50"/>
            <RowDefinition Height="5"/>
            <RowDefinition MinHeight="50"/>
        </Grid.RowDefinitions>
		<TextBox Classes="Search" Grid.Row="0" Margin="5,0,5,5" Text="{Binding FilterText}"/>
        <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*">
	        <TextBlock Text="Event Graph"
	                   Grid.Row="0"
	                   Classes="HeaderSmall"/>
	        <ListBox x:Name="EventList"
	                 Classes="Func"
	                 Grid.Row="1"
	                 SelectionChanged="EventList_OnSelectionChanged"
	                 ItemsSource="{Binding EventsFiltered}">
		        <ListBox.ContextMenu>
			        <ContextMenu>
				        <MenuItem Header="Find in current graph"
				                  Click="EventSearchInCurrentGraph_OnClick"/>
				        <MenuItem Header="Find globally"
				                  DataContext="{Binding #EventList.SelectedItem}"
				                  Click="FunctionSearchGlobal_OnClick"/>
			        </ContextMenu>
		        </ListBox.ContextMenu>
	        </ListBox>
        </Grid>
        <GridSplitter Grid.Row="2"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
	        <TextBlock Text="Functions"
	                   Grid.Row="0"
	                   Classes="HeaderSmall"/>
	        <ListBox x:Name="FunctionList"
	                 Classes="Func"
	                 Grid.Row="1"
	                 SelectionChanged="FunctionList_OnSelectionChanged"
	                 ItemsSource="{Binding FunctionsFiltered}">
		        <ListBox.ContextMenu>
			        <ContextMenu>
				        <MenuItem Header="Find in current graph"
				                  Click="FunctionSearchInCurrentGraph_OnClick"/>
				        <MenuItem Header="Find globally"
				                  DataContext="{Binding #FunctionList.SelectedItem}"
				                  Click="FunctionSearchGlobal_OnClick"/>
			        </ContextMenu>
		        </ListBox.ContextMenu>
	        </ListBox>
        </Grid>
		<GridSplitter Grid.Row="4"/>
		<Grid Grid.Row="5" RowDefinitions="Auto,*">
			<TextBlock Text="Properties"
			           Grid.Row="0"
			           Classes="HeaderSmall"/>
			<ListBox x:Name="PropertyList"
			         Classes="Prop"
			         Grid.Row="1"
			         SelectionChanged="PropertyList_OnSelectionChanged"
			         ItemsSource="{Binding PropertiesFiltered}">
				<ListBox.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Find in current graph"
						          Click="PropertySearchInCurrentGraph_OnClick"/>
						<MenuItem Header="Find globally"
						          DataContext="{Binding #PropertyList.SelectedItem}"
						          Click="PropertySearchGlobal_OnClick"/>
					</ContextMenu>
				</ListBox.ContextMenu>
			</ListBox>
		</Grid>
    </Grid>
</UserControl>
