<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>
	<Style Selector="Window">
		<Setter Property="Background" Value="{StaticResource Background1}"/>
		<Setter Property="Foreground" Value="{StaticResource Foreground}"/>
		<Setter Property="TextBlock.LetterSpacing" Value="0.4"/>
	</Style>
	<Style Selector="GridSplitter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="Button">
		<Setter Property="Background" Value="{StaticResource Background4}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="3"/>
		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{StaticResource Background5}"/>
		</Style>
	</Style>

	<Style Selector="TextBox">
		<Setter Property="Background" Value="{StaticResource Background1}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Background4}"/>
		<Setter Property="CornerRadius" Value="3"/>

		<Style Selector="^.Search">
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Watermark" Value="Search"/>
		</Style>
	</Style>
	
	<Style Selector="ToggleButton">
		<Setter Property="Background" Value="{StaticResource Background4}"/>
		<Setter Property="CornerRadius" Value="3"/>
		<Setter Property="BorderThickness" Value="0"/>

		<Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background5}" />
		</Style>
		<Style Selector="^:pressed  /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background5}" />
		</Style>
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="Background" Value="{StaticResource Background1}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Background4}"/>
		<Setter Property="CornerRadius" Value="3"/>
		<Setter Property="Padding" Value="3"/>
		
		<Style Selector="^:dropdownopen /template/ Popup > Border">
			<Setter Property="Background" Value="{StaticResource Background1}"/>
			<Setter Property="BorderBrush" Value="{StaticResource Background4}"/>
			<Setter Property="Margin" Value="0,3"/>
			<Setter Property="CornerRadius" Value="3"/>
		</Style>
	</Style>
	
	<Style Selector="ComboBoxItem">
		<Setter Property="Padding" Value="3"/>
		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background4}"/>
		</Style>
		<Style Selector="^:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background5}"/>
		</Style>
	</Style>

	<Style Selector="CheckBox">
		<Setter Property="Background" Value="{StaticResource Background1}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Background4}"/>
		<Setter Property="CornerRadius" Value="3"/>
	</Style>

	<Style Selector="TabControl">
		<Setter Property="Padding" Value="0"/>
		<Style Selector="^[TabStripPlacement=Top]">
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="^ /template/ ContentPresenter#PART_SelectedContentHost">
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Background" Value="{StaticResource Background3}" />
		</Style>
		<Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
			<Setter Property="ZIndex" Value="1" />
		</Style>
	</Style>
	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{StaticResource Foreground}" />
		<Setter Property="Margin" Value="0,0,1,0" />
		<Setter Property="Padding" Value="10,3"/>
		<Setter Property="Background" Value="{StaticResource Background1}"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
						Padding="{TemplateBinding Padding}"
						Margin="{TemplateBinding Margin}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="5,5,0,0">
					<ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
				</Border>
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover">
			<Setter Property="Background" Value="{StaticResource Background2}"/>
		</Style>


		<Style Selector="^:selected">
			<Setter Property="Background" Value="{StaticResource Background3}"/>
		</Style>

	</Style>
	<Style Selector="TreeView">
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Style Selector="^ /template/ Border">
			<Setter Property="Background" Value="{StaticResource Background2}"/>
		</Style>
	</Style>

	<Style Selector="TreeViewItem">
		<Style Selector="^ /template/ Border#SelectionBorder:pointerover">
			<Setter Property="Background" Value="{StaticResource Background3}" />
		</Style>

		<Style Selector="^:selected /template/ Border#SelectionBorder">
			<Setter Property="Background" Value="{StaticResource Background4}" />
		</Style>
	</Style>
	
	<Style Selector="ListBoxItem">
		<Setter Property="Padding" Value="0" />
		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background4}" />
		</Style>
		<Style Selector="^:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Background5}" />
		</Style>
	</Style>

	<Style Selector="ListBox">
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Style Selector="^ /template/ Border#border">
			<Setter Property="Background" Value="{StaticResource Background2}"/>
		</Style>
	</Style>

	<Style Selector="TextBlock.Hint">
		<Setter Property="ToolTip.ShowDelay" Value="1"/>
		<Setter Property="TextAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="Margin" Value="7"/>
		<Setter Property="Width" Value="15"/>
		<Setter Property="Text" Value="?"/>
	</Style>

	<Style Selector="TextBlock.HeaderSmall">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Background" Value="{StaticResource Background4}"/>
		<Setter Property="Padding" Value="6"/>
	</Style>

	<Style Selector="FlyoutPresenter.ContextMenu">
		<Setter Property="Background" Value="{StaticResource Background3}" />
		<Setter Property="BorderBrush" Value="{StaticResource Background4}" />
		<Setter Property="Padding" Value="0" />
	</Style>
	
	<Style Selector="TextBlock.Comparable">
		<Style Selector="^.IsAdded">
			<Setter Property="Foreground" Value="MediumSeaGreen"/>
		</Style>
		<Style Selector="^.IsRemoved">
			<Setter Property="Foreground" Value="IndianRed"/>
		</Style>
		<Style Selector="^.IsChanged">
			<Setter Property="Foreground" Value="#EEEE66"/>
		</Style>
	</Style>
</Styles>
