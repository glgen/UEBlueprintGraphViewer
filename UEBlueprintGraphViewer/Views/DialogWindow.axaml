<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:UEBlueprintGraphViewer"
        mc:Ignorable="d" Width="400"
		WindowStartupLocation="CenterScreen"
		SizeToContent="Height"
		DataContext="{Binding $self}"
        x:Class="UEBlueprintGraphViewer.DialogWindow"
        x:DataType="l:DialogWindow"
        Title="DialogWindow">
	<Grid RowDefinitions="*,*,Auto">
		<SelectableTextBlock Text="{Binding MessageText}"
				   TextWrapping="Wrap"
				   Grid.Row="0"
				   Margin="10"/>
		<TextBox Text="{Binding EnteredText}"
				 IsVisible="{Binding AskForText}"
				 x:Name="ValueTextBox"
				 Grid.Row="1"
				 Margin="10,0"/>
		<Grid Grid.Row="2" Margin="10" ColumnDefinitions="*,Auto,10,Auto">
			<Button Content="Cancel"
					IsVisible="{Binding CanCancel}"
					Grid.Column="1"
					Click="Cancel_Click"
					Width="80"/>
			<Button Content="OK"
					Grid.Column="3"
					Click="Ok_Click"
					IsDefault="True"
					Width="80"/>
		</Grid>
	</Grid>
</Window>
